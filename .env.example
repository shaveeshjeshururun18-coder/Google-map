# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# GOOGLE_MAPS_API_KEY: Server-side Google Maps Platform API key
# Requires Map Tiles API (Street View Tiles) and Places API (New) enabled.
GOOGLE_MAPS_API_KEY=""

# VITE_GOOGLE_MAPS_API_KEY: Optional browser-restricted Google Maps JS API key for MiniMap
# Restrict to HTTP referrers and Maps JavaScript API in Google Cloud Console.
VITE_GOOGLE_MAPS_API_KEY=""
